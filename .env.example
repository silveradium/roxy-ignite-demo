# --- robot -------------------------------------------------------------------
# In the Go2's own AP mode the robot is always here and no IP is needed.
GO2_CONN=LocalAP
GO2_IP=192.168.12.1
# Per-device AES-128 key (32 hex chars), required on firmware >= 1.1.15.
# Copy it from the main repo's .env (GO2_AES_KEY) or fetch it with
# unitree_webrtc_connect/examples/fetch_aes_key.py while on the same network.
GO2_AES_KEY=


# --- the Pi ------------------------------------------------------------------
# Where server.py listens. 0.0.0.0 so the laptop can reach it over the robot AP.
PI_HOST=0.0.0.0
PI_PORT=8080
# aplay device for the USB sound card + speaker (`aplay -L` on the Pi)
ALSA_DEVICE=plughw:CARD=Device,DEV=0
# dB on top of the card's maximum, soft-limited (0 = off)
GAIN_DB=0
# Piper .onnx models live here (scripts/setup-pi.sh downloads them)
PIPER_VOICES_DIR=./piper-voices
# Named voice from pi/voices.py: kid, scooby, robot, or <speaker>-<style> e.g. poppy-bright
VOICE=kid
# Hand signs from the Orbbec drive intents (pi/gestures.py, GESTURE_INTENTS). 1 = on.
# Needs requirements-pi-vision.txt, and the FYP's deictic-pi-1 container stopped (it owns the camera).
GESTURES=0
# The camera: "orbbec" finds the Gemini 335's colour stream itself (see gestures.find_orbbec_color;
# its /dev/v4l/by-id link moves after a USB reset), or an index / /dev/videoN for another camera.
CAMERA_DEVICE=orbbec
# Turns are timed: gain x angle / 0.8 rad/s. Above 1 makes up for the robot ramping up and
# slipping. 1.35 measured on our Go2 (2026-11-21: 1.2 turned ~80 deg); redo it with POST /turn
# (pi/server.py turn_handler) for another robot or floor.
TURN_GAIN=1.35
# Spoken replies to the laptop mic come from Gemini (pi/dialog.py); keywords still choose the
# action. Empty key: Roxy uses her fixed lines. Needs internet on the Pi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_WORDS=30
GEMINI_TIMEOUT=10
# What the button says
SENTENCE=Ruh-roh! Hello everyone, I am Roxy.

# --- the laptop (laptop/listen.py) -------------------------------------------
# The Pi's address on the robot's AP. Give wlan0 a static address, or use avahi.
PI_URL=ws://192.168.12.50:8080/ws
# Substring of the mic's name, an index, or "default" (`python3 -m sounddevice`)
MIC_DEVICE=default
MOONSHINE_ARCH=medium-streaming
